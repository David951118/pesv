{
  "info": {
    "name": "Supabase Edge Functions - asegurarcoop",
    "description": "Colección para probar las Edge Functions de Supabase.\n\n1. Configure las variables de colección con su project ID y anon key.\n2. Para rutas protegidas, obtenga un JWT con el endpoint de login de Supabase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "supabaseUrl", "value": "https://nydtkwodebzdxpjtdjos.supabase.co" },
    { "key": "anonKey", "value": "YOUR_ANON_KEY_HERE" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (get access_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) { pm.collectionVariables.set('accessToken', json.access_token); }",
                  "pm.test('Login OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@asegurarcoop.com\",\n  \"password\": \"your-password\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "cellvi-proxy",
      "item": [
        {
          "name": "Obtener Posiciones GPS",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/cellvi-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"positions\"\n}"
            }
          }
        },
        {
          "name": "Obtener Dispositivos",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/cellvi-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"devices\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "apirndc-proxy",
      "item": [
        {
          "name": "Login ApiRdnc",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/apirndc-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"login\"\n}"
            }
          }
        },
        {
          "name": "Health Check via proxy",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/apirndc-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"proxy\",\n  \"method\": \"GET\",\n  \"path\": \"/health\"\n}"
            }
          }
        },
        {
          "name": "Estadísticas Globales via proxy",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/apirndc-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"proxy\",\n  \"method\": \"GET\",\n  \"path\": \"/api/estadisticas/global\"\n}"
            }
          }
        },
        {
          "name": "Listar Vehículos via proxy",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/apirndc-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"proxy\",\n  \"method\": \"GET\",\n  \"path\": \"/api/vehiculos\"\n}"
            }
          }
        },
        {
          "name": "Listar Manifiestos via proxy",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/apirndc-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"proxy\",\n  \"method\": \"GET\",\n  \"path\": \"/api/manifiestos\"\n}"
            }
          }
        },
        {
          "name": "Backup Export via proxy",
          "request": {
            "method": "POST",
            "url": "{{supabaseUrl}}/functions/v1/apirndc-proxy",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"proxy\",\n  \"method\": \"GET\",\n  \"path\": \"/api/backups/export\"\n}"
            }
          }
        }
      ]
    }
  ]
}
