# =============================================================================
# Environment Variables — Asegurar Limitada
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# =============================================================================

# ---------------------------------------------------------------------------
# Cellvi Telemetry Integration
# ---------------------------------------------------------------------------
VITE_CELLVI_ENABLED="false"

# ---------------------------------------------------------------------------
# ApiRdnc Integration (MongoDB backend)
# ---------------------------------------------------------------------------
VITE_APIRNDC_ENABLED="true"
# In development use /rndcapi (Vite proxy). In production use https://rndc.asegurar.com.co
VITE_APIRNDC_BASE_URL=/rndcapi

# ApiRdnc credentials (required). Used to authenticate against the RNDC backend.
# IMPORTANT: These are shipped to the browser bundle. Consider moving auth to a server-side proxy.
VITE_APIRNDC_DEV_USERNAME=
VITE_APIRNDC_DEV_PASSWORD=
