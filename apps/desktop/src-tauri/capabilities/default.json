{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/capabilities-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window. Deny-by-default: only explicitly listed commands are accessible from the WebView.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "core:window:allow-close",
      "allow": []
    },
    {
      "identifier": "core:window:allow-minimize",
      "allow": []
    },
    {
      "identifier": "core:window:allow-start-dragging",
      "allow": []
    },
    "shell:allow-open"
  ]
}
